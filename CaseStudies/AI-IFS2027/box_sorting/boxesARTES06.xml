		</query>
		<query>
			<formula>E&lt;&gt; R1.end</formula>
			<comment/>
		</query>
		<query>
			<formula/>
			<comment/>
		</query>
		<query>
			<formula>E&lt;&gt; R1.off</formula>
			<comment/>
		</query>
		<query>
			<formula>E&lt;&gt; R2.off</formula>
			<comment/>
