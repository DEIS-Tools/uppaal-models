<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE nta PUBLIC '-//Uppaal Team//DTD Flat System 1.6//EN' 'http://www.it.uu.se/research/group/darts/uppaal/flat-1_6.dtd'>
<nta>
	<declaration>/**
Presented by Kim G. Larsen at ARTES 2006 summer school in Uppsala.
https://www.artes.uu.se/events/summer06/kimgl.shtml
*/

const int ctime = 75;

int[0,1] active;
clock x, time;

chan   eject, ok;
urgent chan blck, red, remove, go;</declaration>
	<template>
		<name x="32" y="16">TaskMAIN</name>
		<location id="id0" x="136" y="96">
			<name x="126" y="66">S0</name>
		</location>
		<init ref="id0"/>
		<transition id="id1">
			<source ref="id0"/>
			<target ref="id0"/>
			<label kind="synchronisation" x="40" y="88">red?</label>
			<nail x="88" y="80"/>
			<nail x="88" y="112"/>
		</transition>
		<transition id="id2">
			<source ref="id0"/>
			<target ref="id0"/>
			<label kind="synchronisation" x="200" y="72">blck?</label>
			<label kind="assignment" x="200" y="96">x=0, 
active=true</label>
			<nail x="184" y="80"/>
			<nail x="184" y="112"/>
		</transition>
	</template>
	<template>
		<name x="32" y="16">TaskPUSH</name>
		<location id="id3" x="248" y="96">
			<name x="240" y="112">passive</name>
		</location>
		<location id="id4" x="80" y="104">
			<name x="40" y="112">wait</name>
			<label kind="invariant" x="40" y="128">x&lt;=ctime</label>
		</location>
		<init ref="id3"/>
		<transition id="id5">
			<source ref="id4"/>
			<target ref="id3"/>
			<label kind="guard" x="60" y="44">x==ctime</label>
			<label kind="synchronisation" x="140" y="44">eject!</label>
			<label kind="assignment" x="204" y="44">active=0</label>
			<nail x="100" y="68"/>
			<nail x="228" y="68"/>
		</transition>
		<transition id="id6">
			<source ref="id3"/>
			<target ref="id4"/>
			<label kind="guard" x="108" y="140">active==1</label>
			<label kind="synchronisation" x="212" y="140">go?</label>
			<nail x="228" y="132"/>
			<nail x="100" y="132"/>
		</transition>
	</template>
	<template>
		<name x="32" y="16">Piston</name>
		<declaration>clock y;</declaration>
		<location id="id7" x="96" y="208">
			<name x="104" y="216">s2</name>
			<label kind="invariant" x="104" y="232">y&lt;=1</label>
		</location>
		<location id="id8" x="96" y="64">
			<name x="104" y="72">s1</name>
		</location>
		<init ref="id8"/>
		<transition id="id9">
			<source ref="id8"/>
			<target ref="id7"/>
			<label kind="synchronisation" x="104" y="108">eject?</label>
			<label kind="assignment" x="104" y="168">y=0</label>
		</transition>
		<transition id="id10">
			<source ref="id7"/>
			<target ref="id8"/>
			<label kind="guard" x="152" y="216">y==1</label>
			<nail x="160" y="208"/>
			<nail x="160" y="64"/>
		</transition>
		<transition id="id11">
			<source ref="id7"/>
			<target ref="id8"/>
			<label kind="synchronisation" x="16" y="216">remove!</label>
			<nail x="32" y="208"/>
			<nail x="32" y="64"/>
		</transition>
	</template>
	<template>
		<name x="32" y="16">Dumb</name>
		<location id="id12" x="64" y="64">
			<name x="32" y="56">S0</name>
		</location>
		<init ref="id12"/>
		<transition id="id13">
			<source ref="id12"/>
			<target ref="id12"/>
			<label kind="synchronisation" x="120" y="56">go!</label>
			<nail x="112" y="48"/>
			<nail x="112" y="80"/>
		</transition>
	</template>
	<template>
		<name x="32" y="16">RedBox</name>
		<declaration>clock pos;</declaration>
		<location id="id14" x="304" y="112">
			<name x="312" y="120">on2</name>
			<label kind="invariant" x="312" y="136">pos&lt;=81</label>
		</location>
		<location id="id15" x="560" y="112">
			<name x="568" y="120">end</name>
		</location>
		<location id="id16" x="48" y="112">
			<name x="56" y="120">on1</name>
			<label kind="invariant" x="56" y="136">pos&lt;=9</label>
		</location>
		<location id="id17" x="176" y="112">
			<name x="160" y="120">sensor</name>
